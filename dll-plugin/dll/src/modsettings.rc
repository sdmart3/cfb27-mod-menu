// modsettings.rc: the VERSIONINFO resource of modsettings.dll. The name and the version come from product.h (one place).
#include <windows.h>
#include "product.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION MS_VER_NUMS
 PRODUCTVERSION MS_VER_NUMS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", MS_PRODUCT " for College Football 27"
      VALUE "FileVersion", MS_VERSION
      VALUE "InternalName", MS_STEM
      VALUE "OriginalFilename", MS_STEM ".dll"
      VALUE "ProductName", MS_PRODUCT
      VALUE "ProductVersion", MS_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
