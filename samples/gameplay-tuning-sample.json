{
  "schema": 3,
  "modid": "pocket-presence",
  "title": "Pocket Presence",
  "version": "1.2.0",
  "rows": [
    { "type": "header", "label": "Pass rush" },
    {
      "type": "list", "key": "pocket-depth", "label": "Pocket Depth",
      "description": "How far back the QB's pocket sits. Deeper gives the QB more room but the rush gets home from the edges.",
      "options": ["Shallow", "Stock", "Deep"], "default": 1,
      "bind": { "type": "tuning", "asset": "blocking/BlockingTuning_Main", "field": "PocketCenter_DefaultOffset",
                "copy": "simulation", "values": [2.0, 3.0, 4.5] }
    },
    {
      "type": "slider", "key": "steer-strength", "label": "Open-Space Steering",
      "description": "How strongly pass rushers curve toward gaps between blockers. 0 turns it off.",
      "min": 0, "max": 100, "step": 10, "default": 50, "unit": "%",
      "bind": { "type": "tuning", "asset": "ai/DefenderMovementTuning", "copy": "simulation",
                "field": "DefenderMovement_OpenSpaceBetweenDefendersInfluenceOnDesiredMoveDirectionOnPassRush",
                "instance": "Curve.Points[1].y", "scale": { "at-min": 0.0, "at-max": 1.0 } }
    },
    { "type": "header", "label": "Receivers" },
    {
      "type": "toggle", "key": "jump-catch", "label": "Jump Catches",
      "description": "On: receivers may leap for balls in traffic. Off: feet stay on the ground.",
      "default": true,
      "bind": { "type": "tuning", "asset": "catching/Multiplayer_SP_Catch_DB", "copy": "both",
                "field": "Catching_AllowedToJumpCatch", "values": [false, true] }
    },
    { "type": "info", "label": "Changes apply on the next snap. The base copy is edited too for Jump Catches so Play Now matches Dynasty." }
  ]
}
